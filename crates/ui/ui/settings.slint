// The settings window: Assistants (Accounts, Featured Meters, thresholds, module
// settings), Tray icon (Gauge, Badge), Alerts (polling, reset notifications, Start with
// Windows), About (removal).
// Rows come pre-built from Rust (present/settings.rs); this file only lays them out.
// Fluent style; follows the system light or dark theme.

import { CheckBox, LineEdit, Button, ComboBox, Switch, ScrollView, Palette } from "std-widgets.slint";
import { NavList, NavLogic } from "components/nav_list.slint";
import { Card, NavPage } from "components/card.slint";

export { NavLogic }

export struct SettingRowData {
    // 0 Assistant switch, 1 Account switch, 2 Meter (Featured checkbox and thresholds),
    // 3 module setting switch, 4 module setting text, 5 note,
    // 6 module action (button labelled with `text`)
    kind: int,
    label: string,
    detail: string,
    checked: bool,
    enabled: bool,
    editable: bool,
    text: string,
    placeholder: string,
    // A Featured Meter's place on the tray icon, from 1; 0 when not Featured.
    position: int,
    can-move-up: bool,
    can-move-down: bool,
}

component Caption inherits Text {
    color: Palette.foreground;
    opacity: 0.7;
    font-size: 12px;
    wrap: word-wrap;
    // Slint 1.18 measures wrapped text in `for`/`if` rows at its one-line width, so
    // the Assistants page came out short and its last rows could not be scrolled to.
    // Pinning the minimum to the height at the real width works around it
    // (slint-ui/slint#13655).
    min-height: self.preferred-height;
}

export component SettingsWindow inherits Window {
    in property <[SettingRowData]> rows;
    in property <[string]> poll-options;
    in property <int> poll-index;
    in property <string> poll-warning;
    in property <bool> reset-notifications;
    in property <bool> start-with-windows;
    in property <[string]> gauge-options;
    in property <int> gauge-index;
    in property <bool> show-badge;
    in property <bool> badge-enabled;
    in property <string> data-folder;
    in property <string> version;
    callback row-toggled(int, bool);
    callback row-edited(int, string);
    callback row-accepted(int, string);
    callback row-clicked(int);
    // A Featured Meter's arrow: true moves it up.
    callback row-moved(int, bool);
    callback gauge-selected(int);
    callback show-badge-toggled(bool);
    callback poll-selected(int);
    callback reset-notifications-toggled(bool);
    callback start-with-windows-toggled(bool);
    callback remove-requested(bool);
    // The selected settings page: 0 Assistants, 1 Tray icon, 2 Alerts, 3 About.
    in-out property <int> page: 0;

    title: "UsageQuotaTray settings";
    preferred-width: 600px;
    preferred-height: 580px;
    // Wide enough for the widest Assistants row, which cannot shrink below its labels.
    min-width: max(460px, nav.width + assistant-rows.min-width);
    min-height: 380px;
    background: Palette.background;
    default-font-family: "Segoe UI Variable Text";

    HorizontalLayout {
        nav := NavList {
            items: ["Assistants", "Tray icon", "Alerts", "About"];
            current-index <=> root.page;
        }

        Rectangle {
        NavPage {
            index: 0;
            current: root.page;
            ScrollView {
                assistant-rows := VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    alignment: start;
                    for row[i] in root.rows: VerticalLayout {
                        if row.kind == 0: HorizontalLayout {
                            padding-top: 10px;
                            spacing: 12px;
                            Text {
                                text: row.label;
                                color: Palette.foreground;
                                font-size: 16px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Switch {
                                checked: row.checked;
                                accessible-label: row.label;
                                toggled => {
                                    root.row-toggled(i, self.checked);
                                }
                            }
                        }
                        if row.kind == 1: Card {
                            inner-spacing: 2px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: row.label;
                                    color: Palette.foreground;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Switch {
                                    checked: row.checked;
                                    accessible-label: row.label;
                                    toggled => {
                                        root.row-toggled(i, self.checked);
                                    }
                                }
                            }
                            if row.checked: Caption {
                                text: row.detail;
                            }
                        }
                        if row.kind == 2: Card {
                            inner-padding: 8px;
                            HorizontalLayout {
                            spacing: 12px;
                            CheckBox {
                                text: row.label;
                                checked: row.checked;
                                enabled: row.enabled;
                                horizontal-stretch: 1;
                                toggled => {
                                    root.row-toggled(i, self.checked);
                                }
                            }
                            if row.position > 0: HorizontalLayout {
                                spacing: 2px;
                                Text {
                                    text: row.position;
                                    color: Palette.foreground;
                                    opacity: 0.7;
                                    vertical-alignment: center;
                                    accessible-label: "Place " + row.position + " on the tray icon";
                                }
                                Button {
                                    text: "\u{2191}";
                                    enabled: row.can-move-up;
                                    accessible-label: "Move " + row.label + " up";
                                    clicked => {
                                        root.row-moved(i, true);
                                    }
                                }
                                Button {
                                    text: "\u{2193}";
                                    enabled: row.can-move-down;
                                    accessible-label: "Move " + row.label + " down";
                                    clicked => {
                                        root.row-moved(i, false);
                                    }
                                }
                            }
                            if row.editable: LineEdit {
                                width: 140px;
                                text: row.text;
                                placeholder-text: row.placeholder;
                                accessible-label: "Alert thresholds for " + row.label;
                                edited(t) => {
                                    root.row-edited(i, t);
                                }
                                accepted(t) => {
                                    root.row-accepted(i, t);
                                }
                            }
                            if !row.editable: Caption {
                                width: 140px;
                                text: row.detail;
                                vertical-alignment: center;
                            }
                            }
                        }
                        if row.kind == 3: Card {
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: row.label;
                                    color: Palette.foreground;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                    min-height: self.preferred-height;
                                }
                                Switch {
                                    checked: row.checked;
                                    accessible-label: row.label;
                                    toggled => {
                                        root.row-toggled(i, self.checked);
                                    }
                                }
                            }
                            if row.detail != "": Caption {
                                text: row.detail;
                            }
                        }
                        if row.kind == 4: Card {
                            Text {
                                text: row.label;
                                color: Palette.foreground;
                            }
                            LineEdit {
                                text: row.text;
                                placeholder-text: row.placeholder;
                                accessible-label: row.label;
                                edited(t) => {
                                    root.row-edited(i, t);
                                }
                                accepted(t) => {
                                    root.row-accepted(i, t);
                                }
                            }
                            if row.detail != "": Caption {
                                text: row.detail;
                            }
                        }
                        if row.kind == 6: Card {
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: row.label;
                                    color: Palette.foreground;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                    min-height: self.preferred-height;
                                }
                                Button {
                                    text: row.text;
                                    accessible-label: row.text + " " + row.label;
                                    clicked => {
                                        root.row-clicked(i);
                                    }
                                }
                            }
                            if row.detail != "": Caption {
                                text: row.detail;
                            }
                        }
                        if row.kind == 5: HorizontalLayout {
                            padding-left: 12px;
                            Caption {
                                text: row.label;
                            }
                        }
                    }
                }
            }
        }

        NavPage {
            index: 1;
            current: root.page;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                Card {
                Text {
                    text: "Gauge";
                    color: Palette.foreground;
                    font-weight: 600;
                }
                ComboBox {
                    model: root.gauge-options;
                    current-index: root.gauge-index;
                    accessible-label: "Gauge";
                    selected => {
                        root.gauge-selected(self.current-index);
                    }
                }
                Caption {
                    text: "How the tray icon draws its Featured Meters. The first Featured Meter is the outer ring, the top bar or the number; the Assistants page sets which comes first.";
                }
                }
                Card {
                Switch {
                    text: "Show the Badge";
                    checked: root.show-badge;
                    enabled: root.badge-enabled;
                    toggled => {
                        root.show-badge-toggled(self.checked);
                    }
                }
                Caption {
                    text: root.badge-enabled
                        ? "The mark that tells which Assistant the icon is showing."
                        : "Numbers fill the whole icon, so they leave no room for the Badge.";
                }
                }
            }
        }

        NavPage {
            index: 2;
            current: root.page;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                Card {
                Text {
                    text: "Polling while you are at this PC";
                    color: Palette.foreground;
                    font-weight: 600;
                }
                ComboBox {
                    model: root.poll-options;
                    current-index: root.poll-index;
                    accessible-label: "Polling while you are at this PC";
                    selected => {
                        root.poll-selected(self.current-index);
                    }
                }
                if root.poll-warning != "": Caption {
                    text: root.poll-warning;
                }
                Caption {
                    text: "Alerts fire at 75%, 90% and 100% of each limit unless a Meter sets its own thresholds on the Assistants page.";
                }
                }
                Card {
                Switch {
                    text: "Notify when a window resets";
                    checked: root.reset-notifications;
                    toggled => {
                        root.reset-notifications-toggled(self.checked);
                    }
                }
                Caption {
                    text: "Only for windows that had reached the first threshold.";
                }
                Switch {
                    text: "Start with Windows";
                    checked: root.start-with-windows;
                    toggled => {
                        root.start-with-windows-toggled(self.checked);
                    }
                }
                }
            }
        }

        NavPage {
            index: 3;
            current: root.page;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                Text {
                    text: "UsageQuotaTray " + root.version;
                    color: Palette.foreground;
                    font-size: 20px;
                    font-weight: 600;
                }
                Caption {
                    text: "Settings, logs and Badge overrides are in " + root.data-folder;
                }
                Card {
                Text {
                    text: "Remove UsageQuotaTray from this PC";
                    color: Palette.foreground;
                    font-weight: 600;
                }
                Caption {
                    text: "Deletes the Start with Windows entry and the notification registration, then quits. Delete the app's folder afterwards to remove it completely.";
                }
                delete-data := CheckBox {
                    text: "Also delete settings and logs";
                }
                Button {
                    text: "Remove UsageQuotaTray from this PC\u{2026}";
                    clicked => {
                        root.remove-requested(delete-data.checked);
                    }
                }
                }
            }
        }
        }
    }
}
