// A Windows 11 style settings card: a raised, rounded, hairline-bordered group.
// Children are stacked vertically inside the padding.

import { Palette } from "std-widgets.slint";

export component Card inherits Rectangle {
    in property <length> inner-padding: 12px;
    in property <length> inner-spacing: 4px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.12);
    border-radius: 8px;

    VerticalLayout {
        padding: root.inner-padding;
        spacing: root.inner-spacing;
        @children
    }
}

// A page of the settings window, shown only while its navigation entry is selected.
export component NavPage inherits Rectangle {
    in property <int> index;
    in property <int> current;
    visible: root.index == root.current;
    accessible-role: tab-panel;
    @children
}
